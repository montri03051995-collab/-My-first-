-- ESP สำหรับเกมของคุณเอง
local espEnabled = false
local highlights = {}
local connections = {}

local function removeHighlight(target)
    if highlights[target] then
        highlights[target]:Destroy()
        highlights[target] = nil
    end
end

local function addHighlight(target)
    if not espEnabled or target == player then return end

    local character = target.Character
    if not character then return end

    removeHighlight(target)

    local h = Instance.new("Highlight")
    h.Name = "ProFirstPlayerHighlight"
    h.Adornee = character
    h.FillColor = BLUE
    h.OutlineColor = WHITE
    h.FillTransparency = 0.7
    h.OutlineTransparency = 0
    h.DepthMode = Enum.HighlightDepthMode.Occluded
    h.Parent = character

    highlights[target] = h
end

local function refreshESP()
    for _, target in ipairs(Players:GetPlayers()) do
        if target ~= player then
            if espEnabled then
                addHighlight(target)
            else
                removeHighlight(target)
            end
        end
    end
end

local function watchPlayer(target)
    if target == player or connections[target] then return end

    connections[target] = target.CharacterAdded:Connect(function()
        task.wait(0.5)
        if espEnabled then
            addHighlight(target)
        end
    end)

    if espEnabled then
        addHighlight(target)
    end
end

local function unwatchPlayer(target)
    removeHighlight(target)

    if connections[target] then
        connections[target]:Disconnect()
        connections[target] = nil
    end
end

for _, target in ipairs(Players:GetPlayers()) do
    watchPlayer(target)
end

Players.PlayerAdded:Connect(watchPlayer)
Players.PlayerRemoving:Connect(unwatchPlayer)

toggle.Activated:Connect(function()
    espEnabled = not espEnabled
