-- ระบบ Highlight
local function removeHighlight(target)
    local h = highlights[target]
    if h then
        h:Destroy()
        highlights[target] = nil
    end
end

local function addHighlight(target)
    if not running or not espEnabled or target == player then
        return
    end

    local character = target.Character
    if not character then return end

    removeHighlight(target)

    local h = Instance.new("Highlight")
    h.Name = "ProFirstPlayerHighlight"
    h.Adornee = character
    h.FillColor = BLUE
    h.OutlineColor = WHITE
    h.FillTransparency = 0.7
    h.OutlineTransparency = 0
    h.DepthMode = Enum.HighlightDepthMode.Occluded
    h.Parent = character

    highlights[target] = h
end

local function refreshESP()
    for _, target in ipairs(Players:GetPlayers()) do
        if target ~= player then
            if espEnabled then
                addHighlight(target)
            else
                removeHighlight(target)
            end
        end
    end
end

local function watchPlayer(target)
    if target == player then return end

    connect(target.CharacterAdded, function()
        task.wait(0.5)
        if running and espEnabled then
            addHighlight(target)
        end
    end)

    if espEnabled then
        addHighlight(target)
    end
end

for _, target in ipairs(Players:GetPlayers()) do
    watchPlayer(target)
end

connect(Players.PlayerAdded, watchPlayer)

connect(Players.PlayerRemoving, function(target)
    removeHighlight(target)
end)

-- ปุ่มเปิด/ปิด Highlight
connect(toggle.Activated, function()
    if not running then return end

    espEnabled = not espEnabled
    refreshESP()

    toggle.Text = espEnabled and "ON" or "OFF"
    toggle.BackgroundColor3 = espEnabled and BLUE or PANEL
    espInfo.Text = espEnabled and "สถานะ: เปิด" or "สถานะ: ปิด"
    espInfo.TextColor3 = espEnabled and BLUE or GREY
    status.Text = espEnabled and "● ESP เปิดใช้งาน" or "● ESP ปิดใช้งาน"
end)

