-- Anti-Duplication & Lifecycle Management
if _G.PayomboyZDUMP_Cleanup then
    pcall(_G.PayomboyZDUMP_Cleanup)
    task.wait(0.1)
end

local Cleanups = {}
_G.PayomboyZDUMP_Cleanup = function()
    for _, fn in ipairs(Cleanups) do
        pcall(fn)
    end
end

local function bindConn(signal, fn)
    local c = signal:Connect(fn)
    table.insert(Cleanups, function() pcall(function() c:Disconnect() end) end)
    return c
end

