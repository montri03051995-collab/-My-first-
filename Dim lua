--==================================================
-- 1. SERVICES
--==================================================

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

local LocalPlayer = Players.LocalPlayer

if not LocalPlayer then
    warn("[ProFirst] ไม่พบ LocalPlayer")
    return
end

--==================================================
-- 2. CONFIGURATION
--==================================================

local GREEN = Color3.fromRGB(0, 255, 100)

local FILL_TRANSPARENCY = 0.55
local OUTLINE_TRANSPARENCY = 0

local running = true
local highlightEnabled = false

local highlights = {}
local connections = {}

local Window
local HighlightSwitch

--==================================================
-- 3. CONNECTION MANAGEMENT
--==================================================

local function connect(signal, callback)
    local connection = signal:Connect(callback)
    table.insert(connections, connection)
    return connection
end

local function disconnectAll()
    for _, connection in ipairs(connections) do
        pcall(function()
            connection:Disconnect()
        end)
    end

    table.clear(connections)
end

--==================================================
-- 4. CHECK TARGET
-- ผู้เล่นและ NPC ใช้สีเดียวกัน
--==================================================

local function isTarget(model)
    if not model or not model:IsA("Model") then
        return false
    end

    if model == LocalPlayer.Character then
        return false
    end

    if not model:FindFirstChildOfClass("Humanoid") then
        return false
    end

    return true
end

--==================================================
-- 5. REMOVE HIGHLIGHT
--==================================================

local function removeHighlight(model)
    local highlight = highlights[model]

    if highlight then
        pcall(function()
            highlight:Destroy()
        end)

        highlights[model] = nil
    end
end

--==================================================
-- 6. ADD GREEN HIGHLIGHT
--==================================================

local function addHighlight(model)
    if not running or not highlightEnabled then
        return
    end

    if not isTarget(model) then
        return
    end

    local existing = highlights[model]

    if existing
        and existing.Parent
        and existing.Adornee == model then
        return
    end

    removeHighlight(model)

    local success, result = pcall(function()
        local highlight = Instance.new("Highlight")

        highlight.Name = "ProFirstGreenHighlight"
        highlight.Adornee = model
        highlight.FillColor = GREEN
        highlight.OutlineColor = GREEN
        highlight.FillTransparency = FILL_TRANSPARENCY
        highlight.OutlineTransparency = OUTLINE_TRANSPARENCY

        -- ไม่แสดงทะลุกำแพง
        highlight.DepthMode = Enum.HighlightDepthMode.Occluded

        highlight.Parent = model

        return highlight
    end)

    if success and result then
        highlights[model] = result
    else
        warn("[ProFirst] สร้าง Highlight ไม่สำเร็จ:", result)
    end
end

--==================================================
-- 7. SCAN ALL CHARACTERS / NPC
--==================================================

local function scanAll()
    if not running then
        return
    end

    -- ผู้เล่นทุกคนยกเว้นตัวเอง
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            if highlightEnabled then
                addHighlight(player.Character)
            else
                removeHighlight(player.Character)
            end
        end
    end

    -- NPC และโมเดล Humanoid ที่อยู่ใน Workspace
    for _, object in ipairs(Workspace:GetDescendants()) do
        if object:IsA("Model") and isTarget(object) then
            -- ไม่สร้าง Highlight ซ้ำให้ตัวละครผู้เล่น
            local player = Players:GetPlayerFromCharacter(object)

            if not player then
                if highlightEnabled then
                    addHighlight(object)
                else
                    removeHighlight(object)
                end
            end
        end
    end
end

--==================================================
-- 8. PLAYER EVENTS
--==================================================

local function watchPlayer(player)
    if player == LocalPlayer then
        return
    end

    connect(player.CharacterAdded, function(character)
        task.wait(0.3)

        if running and highlightEnabled then
            addHighlight(character)
        end
    end)

    connect(player.CharacterRemoving, function(character)
        removeHighlight(character)
    end)

    if player.Character and highlightEnabled then
        addHighlight(player.Character)
    end
end

for _, player in ipairs(Players:GetPlayers()) do
    watchPlayer(player)
end

connect(Players.PlayerAdded, function(player)
    if running then
        watchPlayer(player)
    end
end)

connect(Players.PlayerRemoving, function(player)
    if player.Character then
        removeHighlight(player.Character)
    end
end)

--==================================================
-- 9. WATCH NEW NPC MODELS
--==================================================

connect(Workspace.DescendantAdded, function(object)
    if not running or not highlightEnabled then
        return
    end

    if object:IsA("Model") then
        task.defer(function()
            if running and highlightEnabled and object.Parent then
                addHighlight(object)
            end
        end)
    end
end)

connect(Workspace.DescendantRemoving, function(object)
    if object:IsA("Model") then
        removeHighlight(object)
    end
end)

--==================================================
-- 10. LOAD FLUENT
--==================================================

local function loadFluent()
    local success, result = pcall(function()
        local source = game:HttpGet(
            "https://github.com/dawid-scripts/Fluent/releases/latest/download/main.lua"
        )

        assert(type(source) == "string" and #source > 0, "ดาวน์โหลด Fluent ไม่สำเร็จ")

        local compiler, compileError = loadstring(source)
        assert(compiler, compileError or "Compile error")

        return compiler()
    end)

    if not success then
        warn("[ProFirst] โหลด Fluent ไม่สำเร็จ:", result)
        return nil
    end

    return result
end

local Fluent = loadFluent()

if not Fluent then
    disconnectAll()
    return
end

--==================================================
-- 11. CREATE WINDOW
--==================================================

local success, result = pcall(function()
    return Fluent:CreateWindow({
        Title = "ProFirst | นีออนสีเขียว",
        SubTitle = "Player + NPC Highlight",
        TabWidth = 160,
        Size = UDim2.fromOffset(540, 420),
        Acrylic = false,
        Theme = "Dark",
        MinimizeKey = Enum.KeyCode.LeftControl
    })
end)

if not success or not result then
    warn("[ProFirst] สร้างหน้าต่างไม่สำเร็จ:", result)
    disconnectAll()
    return
end

Window = result

local MainTab = Window:AddTab({
    Title = "หน้าหลัก",
    Icon = "eye"
})

local SettingsTab = Window:AddTab({
    Title = "ตั้งค่า",
    Icon = "settings"
})

--==================================================
-- 12. MAIN UI
--==================================================

MainTab:AddParagraph({
    Title = "ProFirst",
    Content = "ผู้เล่นและ NPC ใช้ Highlight สีเขียวนีออนเหมือนกัน"
})

MainTab:AddParagraph({
    Title = "วิธีใช้งาน",
    Content = "เปิดสวิตช์เพื่อแสดง Highlight ให้โมเดล Humanoid ที่ตรวจพบ"
})

HighlightSwitch = MainTab:AddToggle("ProFirstGreenHighlight", {
    Title = "เปิด/ปิด Highlight สีเขียว",
    Description = "แสดงหรือซ่อน Highlight ของผู้เล่นและ NPC",
    Default = false
})

HighlightSwitch:OnChanged(function(value)
    if not running then
        return
    end

    highlightEnabled = value

    if value then
        scanAll()
    else
        for model in pairs(highlights) do
            removeHighlight(model)
        end
    end

    Fluent:Notify({
        Title = "ProFirst",
        Content = value and "เปิด Highlight สีเขียวแล้ว"
            or "ปิด Highlight แล้ว",
        Duration = 3
    })
end)

--==================================================
-- 13. REFRESH BUTTON
--==================================================

MainTab:AddButton({
    Title = "รีเฟรช Highlight",
    Description = "ค้นหาผู้เล่นและ NPC ใหม่",

    Callback = function()
        if not running then
            return
        end

        scanAll()

        Fluent:Notify({
            Title = "ProFirst",
            Content = "ค้นหาเป้าหมายเสร็จแล้ว",
            Duration = 3
        })
    end
})

--==================================================
-- 14. CLEAR BUTTON
--==================================================

MainTab:AddButton({
    Title = "ล้าง Highlight ทั้งหมด",
    Description = "ปิดสวิตช์และลบ Highlight ที่สร้าง",

    Callback = function()
        if not running then
            return
        end

        highlightEnabled = false
        HighlightSwitch:SetValue(false)

        for model in pairs(highlights) do
            removeHighlight(model)
        end

        Fluent:Notify({
            Title = "ProFirst",
            Content = "ล้าง Highlight แล้ว",
            Duration = 3
        })
    end
})

--==================================================
-- 15. MINIMIZE WINDOW
--==================================================

MainTab:AddButton({
    Title = "ย่อหน้าต่าง",
    Description = "ย่อหน้าต่างผ่าน API ของ Fluent",

    Callback = function()
        if not running then
            return
        end

        local ok, err = pcall(function()
            Window:Minimize()
        end)

        if not ok then
            warn("[ProFirst] ย่อหน้าต่างไม่สำเร็จ:", err)

            Fluent:Notify({
                Title = "ProFirst",
                Content = "Fluent รุ่นนี้อาจไม่รองรับ Window:Minimize()",
                Duration = 4
            })
        end
    end
})

--==================================================
-- 16. STOP ALL
--==================================================

MainTab:AddButton({
    Title = "หยุดระบบทั้งหมด",
    Description = "หยุด Event และลบ Highlight ทั้งหมด",

    Callback = function()
        if not running then
            return
        end

        running = false
        highlightEnabled = false

        for model in pairs(highlights) do
            removeHighlight(model)
        end

        disconnectAll()

        pcall(function()
            Fluent:Notify({
                Title = "ProFirst",
                Content = "หยุดระบบแล้ว",
                Duration = 2
            })
        end)

        task.delay(0.3, function()
            pcall(function()
                Window:Minimize()
            end)
        end)
    end
})

