local notifHolder = nil
local function getNotifHolder()
    if notifHolder and notifHolder.Parent then return notifHolder end
    local notifGui = Instance.new("ScreenGui")
    notifGui.Name = "PayomboyZ_NotifHolder"
    notifGui.ResetOnSpawn = false
    notifGui.DisplayOrder = 9999
    pcall(function() notifGui.Parent = GuiParent end)
    table.insert(Cleanups, function() pcall(function() notifGui:Destroy() end) end)

    local holder = Instance.new("Frame")
    holder.Name = "Holder"
    holder.Size = UDim2.new(0, 310, 1, -20)
    holder.Position = UDim2.new(1, -320, 0, 10)
    holder.BackgroundTransparency = 1
    holder.Parent = notifGui

    local layout = Instance.new("UIListLayout")
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.VerticalAlignment = Enum.VerticalAlignment.Bottom
    layout.Padding = UDim.new(0, 8)
    layout.Parent = holder

    notifHolder = holder
    return holder
end

local function notify(title, desc, duration, color)
    duration = duration or 3.5
    color = color or Colors.accent
    task.spawn(function()
        local holder = getNotifHolder()
        local card = Instance.new("Frame")
        card.Size = UDim2.new(1, 0, 0, 58)
        card.BackgroundColor3 = Color3.fromRGB(24, 25, 32)
        card.BackgroundTransparency = 0.05
        card.ClipsDescendants = true
        card.Parent = holder

        local corner = Instance.new("UICorner", card)
        corner.CornerRadius = UDim.new(0, 8)

        local stroke = Instance.new("UIStroke", card)
        stroke.Thickness = 1
        stroke.Color = color
        stroke.Transparency = 0.3

        local bar = Instance.new("Frame", card)
        bar.Size = UDim2.new(0, 4, 1, 0)
        bar.BackgroundColor3 = color

        local tLabel = Instance.new("TextLabel", card)
        tLabel.Size = UDim2.new(1, -16, 0, 20)
        tLabel.Position = UDim2.new(0, 12, 0, 8)
        tLabel.BackgroundTransparency = 1
        tLabel.Text = tostring(title)
        tLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
        tLabel.TextSize = 13
        tLabel.FontFace = Font.fromName("Montserrat", Enum.FontWeight.Bold, Enum.FontStyle.Normal)
        tLabel.TextXAlignment = Enum.TextXAlignment.Left

        local dLabel = Instance.new("TextLabel", card)
        dLabel.Size = UDim2.new(1, -16, 0, 22)
        dLabel.Position = UDim2.new(0, 12, 0, 28)
        dLabel.BackgroundTransparency = 1
        dLabel.Text = tostring(desc)
        dLabel.TextColor3 = Color3.fromRGB(180, 182, 190)
        dLabel.TextSize = 11
        dLabel.FontFace = Font.fromName("Montserrat", Enum.FontWeight.Regular, Enum.FontStyle.Normal)
        dLabel.TextXAlignment = Enum.TextXAlignment.Left
        dLabel.TextWrapped = true

        card.Position = UDim2.new(1, 40, 0, 0)
        TweenService:Create(card, TweenInfo.new(0.35, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), { Position = UDim2.new(0, 0, 0, 0) }):Play()

        task.wait(duration)
        local outTw = TweenService:Create(card, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Position = UDim2.new(1, 40, 0, 0), BackgroundTransparency = 1 })
        outTw:Play()
        outTw.Completed:Connect(function() card:Destroy() end)
    end)
end

