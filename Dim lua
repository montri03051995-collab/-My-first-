local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

if not LocalPlayer then
    warn("[ProFirst] ไม่พบ LocalPlayer")
    return
end

--==================================================
-- 1. LOAD LIBRARIES + ERROR HANDLING
--==================================================

local function loadLibrary(name, url)
    local ok, result = pcall(function()
        local response = game:HttpGet(url)

        assert(
            type(response) == "string" and #response > 0,
            "ดาวน์โหลดไฟล์ไม่สำเร็จหรือไฟล์ว่าง"
        )

        local compile, compileError = loadstring(response)

        assert(compile, compileError or "loadstring ใช้งานไม่ได้")

        return compile()
    end)

    if not ok then
        warn("[ProFirst] โหลด " .. name .. " ไม่สำเร็จ: " .. tostring(result))
        return nil
    end

    if result == nil then
        warn("[ProFirst] " .. name .. " ไม่ส่งค่ากลับ")
        return nil
    end

    return result
end

local Fluent = loadLibrary(
    "Fluent",
    "https://github.com/dawid-scripts/Fluent/releases/latest/download/main.lua"
)

if not Fluent then
    warn("[ProFirst] หยุดทำงาน เพราะโหลด Fluent ไม่สำเร็จ")
    return
end

local SaveManager = loadLibrary(
    "SaveManager",
    "https://raw.githubusercontent.com/dawid-scripts/Fluent/master/Addons/SaveManager.lua"
)

local InterfaceManager = loadLibrary(
    "InterfaceManager",
    "https://raw.githubusercontent.com/dawid-scripts/Fluent/master/Addons/InterfaceManager.lua"
)

if not SaveManager or not InterfaceManager then
    warn("[ProFirst] โหลด Addons ไม่ครบ จึงหยุดเพื่อป้องกัน Error")
    return
end

--==================================================
-- 2. STATE
--==================================================

local BLUE = Color3.fromRGB(0, 170, 255)
local WHITE = Color3.fromRGB(240, 248, 255)

local running = true
local espEnabled = false
local highlights = {}
local connections = {}
local Window

local function connect(signal, callback)
    local connection = signal:Connect(callback)
    table.insert(connections, connection)
    return connection
end

--==================================================
-- 3. HIGHLIGHT FUNCTIONS
--==================================================

local function removeHighlight(target)
    local highlight = highlights[target]

    if highlight then
        pcall(function()
            highlight:Destroy()
        end)

        highlights[target] = nil
    end
end

local function addHighlight(target)
    if not running or not espEnabled then
        return
    end

    if target == LocalPlayer then
        return
    end

    local character = target.Character
    if not character then
        return
    end

    removeHighlight(target)

    local ok, highlight = pcall(function()
        local h = Instance.new("Highlight")
        h.Name = "ProFirstPlayerHighlight"
        h.Adornee = character
        h.FillColor = BLUE
        h.OutlineColor = WHITE
        h.FillTransparency = 0.7
        h.OutlineTransparency = 0
        h.DepthMode = Enum.HighlightDepthMode.Occluded
        h.Parent = character
        return h
    end)

    if ok and highlight then
        highlights[target] = highlight
    else
        warn("[ProFirst] สร้าง Highlight ไม่สำเร็จ:", highlight)
    end
end

local function refreshESP()
    if not running then
        return
    end

    for _, target in ipairs(Players:GetPlayers()) do
        if target ~= LocalPlayer then
            if espEnabled then
                addHighlight(target)
            else
                removeHighlight(target)
            end
        end
    end
end

--==================================================
-- 4. PLAYER EVENTS
--==================================================

local function watchPlayer(target)
    if target == LocalPlayer then
        return
    end

    connect(target.CharacterAdded, function()
        task.wait(0.5)

        if running and espEnabled then
            addHighlight(target)
        end
    end)

    connect(target.CharacterRemoving, function()
        removeHighlight(target)
    end)

    if espEnabled then
        addHighlight(target)
    end
end

for _, target in ipairs(Players:GetPlayers()) do
    watchPlayer(target)
end

connect(Players.PlayerAdded, watchPlayer)

connect(Players.PlayerRemoving, function(target)
    removeHighlight(target)
end)

--==================================================
-- 5. CREATE FLUENT WINDOW
--==================================================

local ok, windowResult = pcall(function()
    return Fluent:CreateWindow({
        Title = "ProFirst",
        SubTitle = "ANIME NEON BLUE",
        TabWidth = 160,
        Size = UDim2.fromOffset(540, 420),
        Acrylic = false,
        Theme = "Dark",
        MinimizeKey = Enum.KeyCode.LeftControl
    })
end)

if not ok or not windowResult then
    warn("[ProFirst] สร้างหน้าต่าง Fluent ไม่สำเร็จ:", windowResult)

    for _, connection in ipairs(connections) do
        connection:Disconnect()
    end

    return
end

Window = windowResult

local Tabs = {
    Main = Window:AddTab({
        Title = "Main",
        Icon = "zap"
    }),

    Settings = Window:AddTab({
        Title = "Settings",
        Icon = "settings"
    })
}

--==================================================
-- 6. MAIN TAB
--==================================================

Tabs.Main:AddParagraph({
    Title = "⚡ ProFirst",
    Content = "ANIME NEON BLUE | Player Highlight"
})

Tabs.Main:AddParagraph({
    Title = "คำแนะนำ",
    Content = "เปิด Player Highlight เพื่อแสดงเส้นขอบตัวละครผู้เล่นอื่น"
})

-- ESP Toggle
local ESPSwitch = Tabs.Main:AddToggle("ProFirstESP", {
    Title = "Player Highlight",
    Description = "เปิดหรือปิด Highlight",
    Default = false
})

ESPSwitch:OnChanged(function(value)
    if not running then
        return
    end

    espEnabled = value
    refreshESP()

    Fluent:Notify({
        Title = "ProFirst",
        Content = value and "ESP เปิดแล้ว" or "ESP ปิดแล้ว",
        Duration = 3
    })
end)

-- Refresh
Tabs.Main:AddButton({
    Title = "Refresh Highlight",
    Description = "อัปเดต Highlight ผู้เล่นปัจจุบัน",
    Callback = function()
        if not running then
            return
        end

        refreshESP()

        Fluent:Notify({
            Title = "ProFirst",
            Content = "อัปเดตเรียบร้อย",
            Duration = 3
        })
    end
})

-- Clear
Tabs.Main:AddButton({
    Title = "Clear Highlight",
    Description = "ปิด ESP และลบ Highlight ทั้งหมด",
    Callback = function()
        if not running then
            return
        end

        espEnabled = false
        ESPSwitch:SetValue(false)
        refreshESP()

        Fluent:Notify({
            Title = "ProFirst",
            Content = "ล้าง Highlight แล้ว",
            Duration = 3
        })
    end
})

-- Minimize
Tabs.Main:AddButton({
    Title = "Minimize Window",
    Description = "ย่อหน้าต่าง Fluent",
    Callback = function()
        if not running then
            return
        end

        local minimizeOK, minimizeError = pcall(function()
            Window:Minimize()
        end)

        if not minimizeOK then
            warn("[ProFirst] Fluent รุ่นนี้ไม่รองรับ Minimize:", minimizeError)

            Fluent:Notify({
                Title = "ProFirst",
                Content = "รุ่น Fluent นี้ไม่รองรับคำสั่งย่อหน้าต่าง",
                Duration = 4
            })
        end
    end
})

--==================================================
-- 7. STOP ALL
--==================================================

Tabs.Main:AddButton({
    Title = "STOP ALL",
    Description = "ปิด ESP ล้าง Highlight และหยุดระบบ",
    Callback = function()
        if not running then
            return
        end

        running = false
        espEnabled = false

        for target in pairs(highlights) do
            removeHighlight(target)
        end

        for _, connection in ipairs(connections) do
            if connection.Connected then
                connection:Disconnect()
            end
        end

        table.clear(connections)

        pcall(function()
            Fluent:Notify({
                Title = "ProFirst",
                Content = "หยุดระบบแล้ว",
                Duration = 2
            })
        end)

        task.delay(0.3, function()
            pcall(function()
                Fluent:Unload()
            end)
        end)
    end
})

--==================================================
-- 8. SETTINGS + CONFIGURATION
--==================================================

local setupOK, setupError = pcall(function()
    SaveManager:SetLibrary(Fluent)
    InterfaceManager:SetLibrary(Fluent)

    SaveManager:IgnoreThemeSettings()
    SaveManager:SetIgnoreIndexes({})

    InterfaceManager:SetFolder("ProFirst")
    SaveManager:SetFolder("ProFirst/Configurations")

    InterfaceManager:BuildInterfaceSection(Tabs.Settings)
    SaveManager:BuildConfigSection(Tabs.Settings)
end)

if not setupOK then
    warn("[ProFirst] ตั้งค่า Addons ไม่สำเร็จ:", setupError)
end

