-- ==================== ESP SYSTEM (UI-BASED) ====================
local function isBot(model)
    return Players:GetPlayerFromCharacter(model) == nil
end

local function addESP(model)
    if targets[model] then return end
    if model == LocalPlayer.Character then return end
    
    local hum = model:FindFirstChildOfClass("Humanoid")
    local root = model:FindFirstChild("HumanoidRootPart")
    if not hum or not root then return end

    local col = isBot(model) and BOT_COLOR or PLAYER_COLOR

    -- Highlight
    local hl = nil
    pcall(function()
        hl = Instance.new("Highlight")
        hl.Adornee = model
        hl.FillColor = col
        hl.OutlineColor = col
        hl.FillTransparency = 0.5
        hl.Parent = model
    end)

    -- Text Label
    local lb = Instance.new("TextLabel")
    lb.BackgroundTransparency = 1
    lb.TextColor3 = col
    lb.TextStrokeTransparency = 0
    lb.Font = Enum.Font.GothamBold
    lb.TextSize = 11
    lb.Size = UDim2.fromOffset(200, 20)
    lb.AnchorPoint = Vector2.new(0.5, 1)
    lb.Parent = mainGui

    -- 2D Box (ใช้ Roblox Frame)
    local boxFrame = Instance.new("Frame")
    boxFrame.BackgroundTransparency = 1
    boxFrame.Visible = false
    boxFrame.Parent = mainGui

    local boxStroke = Instance.new("UIStroke")
    boxStroke.Color = col
    boxStroke.Thickness = 1.5
    boxStroke.Parent = boxFrame

    -- Tracer Line (ใช้ Roblox Frame)
    local lineFrame = Instance.new("Frame")
    lineFrame.BackgroundColor3 = col
    lineFrame.BorderSizePixel = 0
    lineFrame.AnchorPoint = Vector2.new(0.5, 0.5)
    lineFrame.Visible = false
    lineFrame.Parent = mainGui

    local plr = Players:GetPlayerFromCharacter(model)
    local nameTxt = plr and plr.Name or model.Name

    targets[model] = {
        Highlight = hl,
        Label = lb,
        Box = boxFrame,
        Line = lineFrame,
        Humanoid = hum,
        RootPart = root,
        Name = nameTxt
    }
end

local function removeESP(model)
    if targets[model] then
        pcall(function() if targets[model].Highlight then targets[model].Highlight:Destroy() end end)
        pcall(function() if targets[model].Label then targets[model].Label:Destroy() end end)
        pcall(function() if targets[model].Box then targets[model].Box:Destroy() end end)
        pcall(function() if targets[model].Line then targets[model].Line:Destroy() end end)
        targets[model] = nil
    end
end

local function scan()
    if not espEnabled then return end
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Humanoid") and obj.Parent then
            addESP(obj.Parent)
        end
    end
end

renderConnection = RunService.RenderStepped:Connect(function()
    if not espEnabled then
        for _, data in pairs(targets) do
            if data.Label then data.Label.Visible = false end
            if data.Box then data.Box.Visible = false end
            if data.Line then data.Line.Visible = false end
            if data.Highlight then data.Highlight.Enabled = false end
        end
        return
    end

    local cam = Workspace.CurrentCamera
    if not cam then return end
    local viewportSize = cam.ViewportSize
    local bottomCenter = Vector2.new(viewportSize.X / 2, viewportSize.Y)

    for model, data in pairs(targets) do
        if not model or not model.Parent or data.Humanoid.Health <= 0 then
            removeESP(model)
        else
            if data.Highlight then data.Highlight.Enabled = true end
            local root = data.RootPart
            local vec, onScreen = cam:WorldToViewportPoint(root.Position)

            if onScreen then
                local dist = (cam.CFrame.Position - root.Position).Magnitude
                local sizeY = math.clamp(2500 / dist, 12, 600)
                local sizeX = sizeY * 0.60

                -- 1. Box
                data.Box.Visible = true
                data.Box.Size = UDim2.fromOffset(sizeX, sizeY)
                data.Box.Position = UDim2.fromOffset(vec.X - (sizeX / 2), vec.Y - (sizeY / 2))

                -- 2. Label
                data.Label.Visible = true
                data.Label.Position = UDim2.fromOffset(vec.X, vec.Y - (sizeY / 2) - 5)
                data.Label.Text = string.format("%s (%d studs)", data.Name, math.floor(dist))

                -- 3. Line (Tracer)
                local targetPos = Vector2.new(vec.X, vec.Y + (sizeY / 2))
                local distance = (bottomCenter - targetPos).Magnitude
                local center = (bottomCenter + targetPos) / 2
                local angle = math.deg(math.atan2(targetPos.Y - bottomCenter.Y, targetPos.X - bottomCenter.X))

                data.Line.Visible = true
                data.Line.Size = UDim2.fromOffset(distance, 1.5)
                data.Line.Position = UDim2.fromOffset(center.X, center.Y)
                data.Line.Rotation = angle
            else
                data.Label.Visible = false
                data.Box.Visible = false
                data.Line.Visible = false
            end
        end
    end
end)

toggleBtn.MouseButton1Click:Connect(function()
