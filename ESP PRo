local function loadFluent()
    local ok, result = pcall(function()
        local source = game:HttpGet(
            "https://github.com/dawid-scripts/Fluent/releases/latest/download/main.lua"
        )
        assert(type(source) == "string" and #source > 0, "โหลด Fluent ไม่สำเร็จ")
        local compiler, err = loadstring(source)
        assert(compiler, err or "Compile error")
        return compiler()
    end)
    if not ok then
        warn("[ProFirst] โหลด Fluent ไม่สำเร็จ:", result)
        return nil
    end
    return result
end

Fluent = loadFluent()
if not Fluent then
    disconnectAll()
    espGui:Destroy()
    return
end

