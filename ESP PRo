-- FOV CIRCLE
--==================================================

local function createFOV()
    if fovCircle then fovCircle:Destroy() end
    local f = Instance.new("Frame")
    f.Name = "FOVCircle"
    f.AnchorPoint = Vector2.new(0.5, 0.5)
    f.Position = UDim2.fromScale(0.5, 0.5)
    f.Size = UDim2.fromOffset(state.AimFOV * 2, state.AimFOV * 2)
    f.BackgroundTransparency = 1
    f.Visible = false
    f.Parent = espGui
    Instance.new("UICorner", f).CornerRadius = UDim.new(1, 0)
    local stroke = Instance.new("UIStroke")
    stroke.Color = BOT_COLOR
    stroke.Thickness = 1
    stroke.Transparency = 0.5
    stroke.Parent = f
    fovCircle = f
end

--==================================================
-- CREATE / REMOVE ENTRY
--==================================================

local function removeTarget(model)
    local e = targets[model]
    if not e then return end
    if lockedTarget == model then lockedTarget = nil end
    targets[model] = nil
    for _, obj in pairs(e) do
        pcall(function() obj:Destroy() end)
    end
end

local function deferRemove(model)
    if pendingRemoval[model] then return end
    pendingRemoval[model] = true
    task.defer(function()
        pendingRemoval[model] = nil
        if targets[model] then removeTarget(model) end
    end)
end

local function addTarget(model)
    if not running or not state.Master then return end
    if not isTarget(model) or targets[model] then return end
    if pendingRemoval[model] then return end

    local col = colorFor(model)

    local box = Instance.new("Frame")
    box.Name = "Box"
    box.BackgroundTransparency = 1
    box.BorderSizePixel = 0
    box.Visible = false
    box.Parent = espGui
    local stroke = Instance.new("UIStroke")
    stroke.Color = col
    stroke.Thickness = 1.5
    stroke.Parent = box

    local tracer = Instance.new("Frame")
    tracer.Name = "Tracer"
    tracer.BackgroundColor3 = col
    tracer.BorderSizePixel = 0
    tracer.AnchorPoint = Vector2.new(0.5, 0.5)
    tracer.Visible = false
    tracer.Parent = espGui

    local label = Instance.new("TextLabel")
    label.Name = "Distance"
    label.BackgroundTransparency = 1
    label.TextColor3 = col
    label.TextStrokeTransparency = 0
    label.Font = Enum.Font.GothamBold
    label.TextSize = 13
    label.Size = UDim2.fromOffset(150, 16)
    label.AnchorPoint = Vector2.new(0.5, 1)
    label.Visible = false
    label.Parent = espGui

    local nameLabel = Instance.new("TextLabel")
    nameLabel.Name = "NameTag"
    nameLabel.BackgroundTransparency = 1
    nameLabel.TextColor3 = Color3.new(1, 1, 1)
    nameLabel.TextStrokeTransparency = 0
    nameLabel.Font = Enum.Font.GothamBold
    nameLabel.TextSize = 12
    nameLabel.Size = UDim2.fromOffset(170, 14)
    nameLabel.AnchorPoint = Vector2.new(0.5, 0)
    nameLabel.Visible = false
    nameLabel.Parent = espGui
    local plr = Players:GetPlayerFromCharacter(model)
    nameLabel.Text = plr and plr.Name or model.Name

    local hpBack = Instance.new("Frame")
    hpBack.Name = "HPBack"
    hpBack.BackgroundColor3 = Color3.new(0, 0, 0)
    hpBack.BackgroundTransparency = 0.4
    hpBack.BorderSizePixel = 0
    hpBack.Visible = false
    hpBack.Parent = espGui

    local hpFill = Instance.new("Frame")
    hpFill.Name = "HPFill"
    hpFill.BackgroundColor3 = Color3.fromRGB(0, 255, 100)
    hpFill.BorderSizePixel = 0
    hpFill.Parent = hpBack

    targets[model] = {
        Box = box, Tracer = tracer, Label = label,
        NameLabel = nameLabel, HPBack = hpBack, HPFill = hpFill
    }
end

local function syncHighlight(model, e)
    if state.Highlight and (not e.Highlight or e.Highlight.Parent == nil) then
        e.Highlight = nil
        local ok, h = pcall(function()
            local hl = Instance.new("Highlight")
            hl.Name = "ProFirstHL"
            hl.Adornee = model
            hl.FillColor = colorFor(model)
            hl.OutlineColor = colorFor(model)
            hl.FillTransparency = FILL_TRANSPARENCY
            hl.OutlineTransparency = 0
            hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            hl.Parent = model
            return hl
        end)
        if ok then e.Highlight = h end
    elseif state.Highlight and e.Highlight then
        e.Highlight.FillColor = colorFor(model)
        e.Highlight.OutlineColor = colorFor(model)
        e.Highlight.Adornee = model
    elseif not state.Highlight and e.Highlight then
        pcall(function() e.Highlight:Destroy() end)
        e.Highlight = nil
    end
end

local function clearAll()
    for model in pairs(targets) do removeTarget(model) end
    table.clear(pendingRemoval)
    lockedTarget = nil
end

local function scanAll()
    if not running or not state.Master then return end
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Humanoid") and obj.Parent then
            addTarget(obj.Parent)
        end
    end
    for _, plr in ipairs(Players:GetPlayers()) do
        local ch = plr.Character
        if ch and ch:FindFirstChildOfClass("Humanoid") then
            addTarget(ch)
        end
    end
end

--==================================================
-- EVENTS: Workspace
--==================================================

connect(Workspace.DescendantAdded, function(obj)
    if not running or not state.Master then return end
    if obj:IsA("Humanoid") then
        task.defer(function()
            if obj.Parent then addTarget(obj.Parent) end
        end)
    elseif obj:IsA("Model") and obj:FindFirstChildOfClass("Humanoid") then
        task.defer(function() addTarget(obj) end)
    end
end)

connect(Workspace.DescendantRemoving, function(obj)
    if obj:IsA("Humanoid") then
        local parent = obj.Parent
        if parent then deferRemove(parent) end
    elseif obj:IsA("Model") and targets[obj] then
        deferRemove(obj)
    end
end)

--==================================================
-- EVENTS: ผู้เล่นเข้า / respawn
--==================================================

local function hookPlayer(plr)
    if plr == LocalPlayer then return end
    connect(plr.CharacterAdded, function(ch)
        task.defer(function()
            task.wait(0.25)
            if running and state.Master and ch then
                ch:WaitForChild("Humanoid", 5)
                addTarget(ch)
            end
        end)
    end)
end

connect(Players.PlayerAdded, hookPlayer)
for _, plr in ipairs(Players:GetPlayers()) do
    hookPlayer(plr)
end

connect(LocalPlayer.CharacterAdded, function()
    task.defer(function()
        if running and state.Master then
            task.wait(0.3)
            scanAll()
        end
    end)
end)

--==================================================
-- AUTO RE-SCANNER
--==================================================

task.spawn(function()
    while running do
        task.wait(SCAN_INTERVAL)
        if running and state.Master and state.AutoScan then
            scanAll()
            for _, child in ipairs(espGui:GetChildren()) do
                local stillUsed = false
                for _, e in pairs(targets) do
                    for _, v in pairs(e) do
                        if v == child then stillUsed = true break end
                    end
                    if stillUsed then break end
                end
                if not stillUsed and child.Name ~= "FOVCircle" then
                    pcall(function() child:Destroy() end)
                end
            end
        end
    end
end)

--==================================================
-- AIM HELPERS
--==================================================

local function getAimPart(model)
    return model:FindFirstChild(state.AimPart)
        or model:FindFirstChild("HumanoidRootPart")
        or model:FindFirstChild("Head")
end

local function findClosestTarget()
    local camera = Workspace.CurrentCamera
    if not camera then return nil end
    local viewport = camera.ViewportSize
    local center = viewport / 2
    local best, bestDist = nil, state.AimFOV
    for model in pairs(targets) do
        local hum = model:FindFirstChildOfClass("Humanoid")
        local part = getAimPart(model)
        if hum and hum.Health > 0 and part then
            local sp, onScreen = camera:WorldToViewportPoint(part.Position)
            if onScreen and sp.Z > 0 then
                local d = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                local studs = (camera.CFrame.Position - part.Position).Magnitude
                if d < bestDist and studs <= MAX_DISTANCE then
                    best, bestDist = model, d
                end
            end
        end
    end
    return best
end

connect(UserInputService.InputBegan, function(input, gp)
    if gp then return end
    if input.KeyCode == Enum.KeyCode.Q then
        if lockedTarget then
            lockedTarget = nil
            pcall(function()
                Fluent:Notify({ Title = "ProFirst", Content = "ปลดล็อกเป้าแล้ว", Duration = 2 })
            end)
        else
            lockedTarget = findClosestTarget()
            pcall(function()
                if lockedTarget then
                    local plr = Players:GetPlayerFromCharacter(lockedTarget)
                    Fluent:Notify({
                        Title = "ProFirst",
                        Content = "ล็อกเป้า: " .. (plr and plr.Name or lockedTarget.Name),
                        Duration = 2
                    })
                end
            end)
        end
    end
end)

--==================================================
-- RENDER LOOP
--==================================================

local function hide(e)
    e.Box.Visible = false
    e.Tracer.Visible = false
    e.Label.Visible = false
    if e.NameLabel then e.NameLabel.Visible = false end
    if e.HPBack then e.HPBack.Visible = false end
end

connect(RunService.RenderStepped, function(dt)
    if not running or not state.Master then return end

    local camera = Workspace.CurrentCamera
    if not camera then return end

    local viewport = camera.ViewportSize
    local screenCenter = viewport / 2
    local origin = Vector2.new(viewport.X / 2, viewport.Y)
    local camPos = camera.CFrame.Position

    if fovCircle then
        fovCircle.Visible = state.LockAim and state.ShowFOV
        fovCircle.Size = UDim2.fromOffset(state.AimFOV * 2, state.AimFOV * 2)
    end

    if lockedTarget then
        local h = lockedTarget:FindFirstChildOfClass("Humanoid")
        local part = getAimPart(lockedTarget)
        if not h or h.Health <= 0 or not part then
            lockedTarget = nil
        end
    end

    for model, e in pairs(targets) do
        local root = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
        local hum = model:FindFirstChildOfClass("Humanoid")

        if not root or not hum then
            deferRemove(model)
        else
            syncHighlight(model, e)

            if hum.Health <= 0 then
                hide(e)
            else
                local studs = (camPos - root.Position).Magnitude
                if studs > MAX_DISTANCE then
                    hide(e)
                else
                    local cf, size = model:GetBoundingBox()
                    local center, onScreen = camera:WorldToViewportPoint(cf.Position)
                    local topP = camera:WorldToViewportPoint(cf.Position + Vector3.new(0, size.Y / 2, 0))
                    local botP = camera:WorldToViewportPoint(cf.Position - Vector3.new(0, size.Y / 2, 0))
                    local pinned = state.LockNear and studs <= nearDistance and center.Z > 0

                    if center.Z <= 0 or (not pinned and not onScreen) then
                        hide(e)
                    else
                        local height = math.abs(botP.Y - topP.Y)
                        local cx, cy = center.X, center.Y
                        if pinned then
                            cx, cy = screenCenter.X, screenCenter.Y
                            height = math.min(height, viewport.Y * 0.5)
                        end
                        local width = height * 0.6
                        local col = colorFor(model)

                        e.Box.Visible = state.Box
                        e.Box.Position = UDim2.fromOffset(cx - width / 2, cy - height / 2)
                        e.Box.Size = UDim2.fromOffset(width, height)

                        if state.Tracer then
                            local footY = pinned and (cy + height / 2) or botP.Y
                            local footX = pinned and cx or botP.X
                            local target = Vector2.new(footX, footY)
                            local delta = target - origin
                            e.Tracer.Visible = true
                            e.Tracer.Size = UDim2.fromOffset(delta.Magnitude, 1.5)
                            e.Tracer.Position = UDim2.fromOffset(
                                (origin.X + target.X) / 2,
                                (origin.Y + target.Y) / 2
                            )
                            e.Tracer.Rotation = math.deg(math.atan2(delta.Y, delta.X))
                        else
                            e.Tracer.Visible = false
                        end

                        if state.Distance then
                            e.Label.Visible = true
                            e.Label.TextColor3 = col
                            e.Label.Text = string.format(
                                "%s%d studs",
                                isBot(model) and "[BOT] " or "[P] ",
                                math.floor(studs + 0.5)
                            )
                            e.Label.Position = UDim2.fromOffset(cx, cy - height / 2 - 2)
                        else
                            e.Label.Visible = false
                        end

                        if state.NameTag and e.NameLabel then
                            local plr = Players:GetPlayerFromCharacter(model)
                            e.NameLabel.Text = plr and plr.Name or model.Name
                            e.NameLabel.Visible = true
                            e.NameLabel.Position = UDim2.fromOffset(cx, cy + height / 2 + 2)
                        elseif e.NameLabel then
                            e.NameLabel.Visible = false
                        end

                        if state.HealthBar and e.HPBack and e.HPFill then
                            local ratio = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
                            e.HPBack.Visible = true
                            e.HPBack.Position = UDim2.fromOffset(cx - width / 2 - 8, cy - height / 2)
                            e.HPBack.Size = UDim2.fromOffset(4, height)
                            e.HPFill.Size = UDim2.fromScale(1, ratio)
                            e.HPFill.Position = UDim2.fromScale(0, 1 - ratio)
                            e.HPFill.BackgroundColor3 = Color3.fromRGB(
                                math.floor(255 * (1 - ratio)),
                                math.floor(255 * ratio),
                                0
                            )
                        elseif e.HPBack then
                            e.HPBack.Visible = false
                        end
                    end
                end
            end
        end
    end

    -- AIM LOCK
    if state.LockAim and lockedTarget then
        local part = getAimPart(lockedTarget)
        if part then
            local sp = camera:WorldToViewportPoint(part.Position)
            if sp.Z > 0 then
                local targetPos = Vector2.new(sp.X, sp.Y)
                local center = viewport / 2
                local delta = (targetPos - center) * math.clamp(state.AimSmooth * dt, 0, 1)
                camera.CFrame = camera.CFrame * CFrame.new(delta.X * 0.5, -delta.Y * 0.5, 0)

                if state.TriggerBot then
                    local dist = (targetPos - center).Magnitude
                    if dist < 12 and (os.clock() - lastShot) >= state.TriggerDelay then
                        lastShot = os.clock()
                        mouse1press()
                        task.delay(0.05, function() mouse1release() end)
                    end
                end
            end
        end
    end
end)

