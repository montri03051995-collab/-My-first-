    Title = "รีเฟรชทันที",
    Description = "สแกนเป้าใหม่ทั้งหมด",
    Callback = function()
        if running then
            scanAll()
            Fluent:Notify({ Title = "ProFirst", Content = "รีเฟรชเสร็จแล้ว", Duration = 3 })
        end
    end
})

MainTab:AddButton({
    Title = "หยุดระบบทั้งหมด",
    Description = "ลบ GUI + ตัด Event ทั้งหมด",
    Callback = function()
        if not running then return end
        running = false
        state.Master = false
        lockedTarget = nil
        if fovCircle then pcall(function() fovCircle:Destroy() end) fovCircle = nil end
        clearAll()
        disconnectAll()
        espGui:Destroy()
        pcall(function()
            Fluent:Notify({ Title = "ProFirst", Content = "หยุดระบบแล้ว", Duration = 2 })
        end)
        task.delay(0.3, function()
            pcall(function() Window:Minimize() end)
        end)
    end
})

