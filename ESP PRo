local tabs = {}
local function createTabButton(name, iconText, order)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, 35)
    btn.BackgroundColor3 = THEME_PANEL
    btn.Text = "  " .. iconText .. " " .. name
    btn.TextColor3 = Color3.fromRGB(180, 200, 220)
    btn.Font = Enum.Font.GothamMedium
    btn.TextSize = 13
    btn.TextXAlignment = Enum.TextXAlignment.Left
    btn.LayoutOrder = order
    btn.Parent = navContainer

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 6)
    corner.Parent = btn

    local tabFrame = Instance.new("ScrollingFrame")
    tabFrame.Size = UDim2.new(1, 0, 1, 0)
    tabFrame.BackgroundTransparency = 1
    tabFrame.ScrollBarThickness = 2
    tabFrame.Visible = false
    tabFrame.Parent = contentArea

    local contentLayout = Instance.new("UIListLayout")
    contentLayout.Padding = UDim.new(0, 10)
    contentLayout.SortOrder = Enum.SortOrder.LayoutOrder
    contentLayout.Parent = tabFrame

    btn.MouseButton1Click:Connect(function()
        for _, t in pairs(tabs) do
            t.Btn.BackgroundColor3 = THEME_PANEL
            t.Btn.TextColor3 = Color3.fromRGB(180, 200, 220)
            t.Frame.Visible = false
        end
        btn.BackgroundColor3 = Color3.fromRGB(0, 120, 215)
        btn.TextColor3 = Color3.fromRGB(255, 255, 255)
        tabFrame.Visible = true
    end)

    tabs[name] = {Btn = btn, Frame = tabFrame}
    return tabFrame
end

