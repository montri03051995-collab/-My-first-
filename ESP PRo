local function createFOV()
    if fovCircle then fovCircle:Destroy() end
    local f = Instance.new("Frame")
    f.Name = "FOVCircle"
    f.AnchorPoint = Vector2.new(0.5, 0.5)
    f.Position = UDim2.fromScale(0.5, 0.5)
    f.Size = UDim2.fromOffset(state.AimFOV * 2, state.AimFOV * 2)
    f.BackgroundTransparency = 1
    f.Visible = false
    f.Parent = espGui
    Instance.new("UICorner", f).CornerRadius = UDim.new(1, 0)
    local s = Instance.new("UIStroke")
    s.Color = BOT_COLOR; s.Thickness = 1; s.Transparency = 0.5; s.Parent = f
    fovCircle = f
end

--==================================================
-- TARGET ENTRY
--==================================================

local function removeTarget(model)
    local e = targets[model]
    if not e then return end
    if lockedTarget == model then lockedTarget = nil end
    targets[model] = nil
    for _, obj in pairs(e) do pcall(function() obj:Destroy() end) end
end

local function deferRemove(model)
    if pendingRemoval[model] then return end
    pendingRemoval[model] = true
    task.defer(function()
        pendingRemoval[model] = nil
        if targets[model] then removeTarget(model) end
    end)
end

local function addTarget(model)
    if not running or not state.Master then return end
    if not isTarget(model) or targets[model] or pendingRemoval[model] then return end

    local col = colorFor(model)

    local box = Instance.new("Frame")
    box.Name = "Box"; box.BackgroundTransparency = 1
    box.BorderSizePixel = 0; box.Visible = false; box.Parent = espGui
    local st = Instance.new("UIStroke")
    st.Color = col; st.Thickness = 1.5; st.Parent = box

    local tr = Instance.new("Frame")
    tr.Name = "Tracer"; tr.BackgroundColor3 = col; tr.BorderSizePixel = 0
    tr.AnchorPoint = Vector2.new(0.5, 0.5); tr.Visible = false; tr.Parent = espGui

    local lb = Instance.new("TextLabel")
    lb.Name = "Distance"; lb.BackgroundTransparency = 1
    lb.TextColor3 = col; lb.TextStrokeTransparency = 0
    lb.Font = Enum.Font.GothamBold; lb.TextSize = 13
    lb.Size = UDim2.fromOffset(150, 16)
    lb.AnchorPoint = Vector2.new(0.5, 1); lb.Visible = false; lb.Parent = espGui

    local nl = Instance.new("TextLabel")
    nl.Name = "NameTag"; nl.BackgroundTransparency = 1
    nl.TextColor3 = Color3.new(1, 1, 1); nl.TextStrokeTransparency = 0
    nl.Font = Enum.Font.GothamBold; nl.TextSize = 12
    nl.Size = UDim2.fromOffset(170, 14)
    nl.AnchorPoint = Vector2.new(0.5, 0); nl.Visible = false; nl.Parent = espGui
    local plr = Players:GetPlayerFromCharacter(model)
    nl.Text = plr and plr.Name or model.Name

    local hb = Instance.new("Frame")
    hb.Name = "HPBack"; hb.BackgroundColor3 = Color3.new(0, 0, 0)
    hb.BackgroundTransparency = 0.4; hb.BorderSizePixel = 0
    hb.Visible = false; hb.Parent = espGui

    local hf = Instance.new("Frame")
    hf.Name = "HPFill"; hf.BackgroundColor3 = Color3.fromRGB(0, 255, 100)
    hf.BorderSizePixel = 0; hf.Parent = hb

    targets[model] = { Box = box, Tracer = tr, Label = lb, NameLabel = nl, HPBack = hb, HPFill = hf }
end

local function syncHighlight(model, e)
    if state.Highlight and (not e.Highlight or e.Highlight.Parent == nil) then
        e.Highlight = nil
        local ok, h = pcall(function()
            local hl = Instance.new("Highlight")
            hl.Name = "ProFirstHL"; hl.Adornee = model
            hl.FillColor = colorFor(model); hl.OutlineColor = colorFor(model)
            hl.FillTransparency = FILL_TRANSPARENCY; hl.OutlineTransparency = 0
            hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            hl.Parent = model
            return hl
        end)
        if ok then e.Highlight = h end
    elseif state.Highlight and e.Highlight then
        e.Highlight.FillColor = colorFor(model)
        e.Highlight.OutlineColor = colorFor(model)
        e.Highlight.Adornee = model
    elseif not state.Highlight and e.Highlight then
        pcall(function() e.Highlight:Destroy() end)
        e.Highlight = nil
    end
end

local function clearAll()
    for model in pairs(targets) do removeTarget(model) end
    table.clear(pendingRemoval)
    lockedTarget = nil
end

local function scanAll()
    if not running or not state.Master then return end
    pcall(function()
        for _, obj in ipairs(Workspace:GetDescendants()) do
            if obj:IsA("Humanoid") and obj.Parent then addTarget(obj.Parent) end
        end
    end)
    for _, plr in ipairs(Players:GetPlayers()) do
        local ch = plr.Character
        if ch and ch:FindFirstChildOfClass("Humanoid") then addTarget(ch) end
    end
end

