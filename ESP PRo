--==================================================
-- CONFIG / STATE
--==================================================

local BOT_COLOR          = Color3.fromRGB(0, 255, 100)
local PLAYER_COLOR       = Color3.fromRGB(255, 40, 40)
local FILL_TRANSPARENCY  = 0.55
local MAX_DISTANCE       = 2500
local SCAN_INTERVAL      = 2

local running = true
local state = {
    Master = false, Highlight = true, Box = true, Tracer = true,
    Distance = true, NameTag = true, HealthBar = true, LockNear = true,
    LockAim = false, AimSmooth = 12, AimPart = "Head", AimFOV = 250,
    ShowFOV = true, TriggerBot = false, TriggerDelay = 0.08,
    TeamCheck = true, AutoScan = true,
}

local nearDistance  = 10
local targets       = {}
local connections   = {}
local pendingRemoval= {}
local Window, lockedTarget, fovCircle, Fluent
local lastShot = 0

--==================================================
-- HELPERS
--==================================================

local function connect(signal, cb)
    local c = signal:Connect(cb)
    table.insert(connections, c)
    return c
end

local function disconnectAll()
    for _, c in ipairs(connections) do pcall(function() c:Disconnect() end) end
    table.clear(connections)
end

local function isBot(model)
    return Players:GetPlayerFromCharacter(model) == nil
end

local function colorFor(model)
    return isBot(model) and BOT_COLOR or PLAYER_COLOR
end

local function isSameTeam(model)
    if not state.TeamCheck then return false end
    local plr = Players:GetPlayerFromCharacter(model)
    if not plr or not LocalPlayer.Team then return false end
    return plr.Team == LocalPlayer.Team
end

local espGui = Instance.new("ScreenGui")
espGui.Name = "ProFirstESP"
espGui.ResetOnSpawn = false
espGui.IgnoreGuiInset = true
espGui.DisplayOrder = 10
espGui.Parent = LocalPlayer:WaitForChild("PlayerGui")

local function isTarget(model)
    if not model or not model:IsA("Model") then return false end
    if model == LocalPlayer.Character then return false end
    if isSameTeam(model) then return false end
    return model:FindFirstChildOfClass("Humanoid") ~= nil
end

-- Delta ยิงเมาส์: ใช้ VirtualInputManager (ฟรีใน Delta)
local function deltaClick()
    pcall(function()
        VirtualInputService:SendMouseButtonEvent(0, 0, 0, true, game, 0)
        task.delay(0.05, function()
            pcall(function()
                VirtualInputService:SendMouseButtonEvent(0, 0, 0, false, game, 0)
            end)
        end)
    end)
end

