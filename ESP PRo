local PLAYER_COLOR       = Color3.fromRGB(255, 40, 40)
local FILL_TRANSPARENCY  = 0.55
local MAX_DISTANCE       = 2500
local SCAN_INTERVAL      = 2

local running = true
local state = {
    Master = false,
    Highlight = true,
    Box = true,
    Tracer = true,
    Distance = true,
    NameTag = true,
    HealthBar = true,
    LockNear = true,
    LockAim = false,
    AimSmooth = 12,
    AimPart = "Head",
    AimFOV = 250,
    ShowFOV = true,
    TriggerBot = false,
    TriggerDelay = 0.08,
    TeamCheck = true,
    AutoScan = true,
