connect(Workspace.DescendantAdded, function(obj)
    if not running or not state.Master then return end
    if obj:IsA("Humanoid") then
        task.defer(function() if obj.Parent then addTarget(obj.Parent) end end)
    elseif obj:IsA("Model") and obj:FindFirstChildOfClass("Humanoid") then
        task.defer(function() addTarget(obj) end)
    end
end)

connect(Workspace.DescendantRemoving, function(obj)
    if obj:IsA("Humanoid") then
        local p = obj.Parent
        if p then deferRemove(p) end
    elseif obj:IsA("Model") and targets[obj] then
        deferRemove(obj)
    end
end)

local function hookPlayer(plr)
    if plr == LocalPlayer then return end
    connect(plr.CharacterAdded, function(ch)
        task.defer(function()
            task.wait(0.25)
            if running and state.Master and ch then
                pcall(function() ch:WaitForChild("Humanoid", 5) end)
                addTarget(ch)
            end
        end)
    end)
end

connect(Players.PlayerAdded, hookPlayer)
for _, plr in ipairs(Players:GetPlayers()) do hookPlayer(plr) end

connect(LocalPlayer.CharacterAdded, function()
    task.defer(function()
        if running and state.Master then task.wait(0.3) scanAll() end
    end)
end)

-- AUTO RE-SCANNER
task.spawn(function()
    while running do
        task.wait(SCAN_INTERVAL)
        if running and state.Master and state.AutoScan then
            scanAll()
            for _, child in ipairs(espGui:GetChildren()) do
                local used = false
                for _, e in pairs(targets) do
                    for _, v in pairs(e) do
                        if v == child then used = true break end
                    end
                    if used then break end
                end
                if not used and child.Name ~= "FOVCircle" then
                    pcall(function() child:Destroy() end)
                end
            end
        end
    end
end)

--==================================================
-- AIM
--==================================================

local function getAimPart(model)
    return model:FindFirstChild(state.AimPart)
        or model:FindFirstChild("HumanoidRootPart")
        or model:FindFirstChild("Head")
end

local function findClosestTarget()
    local cam = Workspace.CurrentCamera
    if not cam then return nil end
    local center = cam.ViewportSize / 2
    local best, bd = nil, state.AimFOV
    for model in pairs(targets) do
        local hum = model:FindFirstChildOfClass("Humanoid")
        local part = getAimPart(model)
        if hum and hum.Health > 0 and part then
            local sp, on = cam:WorldToViewportPoint(part.Position)
            if on and sp.Z > 0 then
                local d = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                if d < bd and (cam.CFrame.Position - part.Position).Magnitude <= MAX_DISTANCE then
                    best, bd = model, d
                end
            end
        end
    end
    return best
end

connect(UserInputService.InputBegan, function(input, gp)
    if gp then return end
    if input.KeyCode == Enum.KeyCode.Q then
        if lockedTarget then
            lockedTarget = nil
            pcall(function() Fluent:Notify({ Title = "ProFirst", Content = "ปลดล็อกเป้าแล้ว", Duration = 2 }) end)
        else
            lockedTarget = findClosestTarget()
            pcall(function()
                if lockedTarget then
                    local plr = Players:GetPlayerFromCharacter(lockedTarget)
                    Fluent:Notify({
                        Title = "ProFirst",
                        Content = "ล็อกเป้า: " .. (plr and plr.Name or lockedTarget.Name),
                        Duration = 2
                    })
                end
            end)
        end
    end
end)

--==================================================
-- RENDER LOOP
--==================================================

local function hide(e)
    e.Box.Visible = false; e.Tracer.Visible = false; e.Label.Visible = false
    if e.NameLabel then e.NameLabel.Visible = false end
    if e.HPBack then e.HPBack.Visible = false end
end

connect(RunService.RenderStepped, function(dt)
    if not running or not state.Master then return end
    local cam = Workspace.CurrentCamera
    if not cam then return end

    local vp = cam.ViewportSize
    local sc = vp / 2
    local org = Vector2.new(vp.X / 2, vp.Y)
    local cp = cam.CFrame.Position

    if fovCircle then
        fovCircle.Visible = state.LockAim and state.ShowFOV
        fovCircle.Size = UDim2.fromOffset(state.AimFOV * 2, state.AimFOV * 2)
    end

    if lockedTarget then
        local h = lockedTarget:FindFirstChildOfClass("Humanoid")
        if not h or h.Health <= 0 or not getAimPart(lockedTarget) then
            lockedTarget = nil
        end
    end

    for model, e in pairs(targets) do
        local root = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
        local hum = model:FindFirstChildOfClass("Humanoid")

        if not root or not hum then
            deferRemove(model)
        else
            syncHighlight(model, e)
            if hum.Health <= 0 then
                hide(e)
            else
                local studs = (cp - root.Position).Magnitude
                if studs > MAX_DISTANCE then
                    hide(e)
                else
                    pcall(function()
                        local cf, size = model:GetBoundingBox()
                        local ctr, on = cam:WorldToViewportPoint(cf.Position)
                        local topP = cam:WorldToViewportPoint(cf.Position + Vector3.new(0, size.Y / 2, 0))
                        local botP = cam:WorldToViewportPoint(cf.Position - Vector3.new(0, size.Y / 2, 0))
                        local pinned = state.LockNear and studs <= nearDistance and ctr.Z > 0

                        if ctr.Z <= 0 or (not pinned and not on) then
                            hide(e)
                        else
                            local h = math.abs(botP.Y - topP.Y)
                            local cx, cy = ctr.X, ctr.Y
                            if pinned then cx, cy = sc.X, sc.Y; h = math.min(h, vp.Y * 0.5) end
                            local w = h * 0.6
                            local col = colorFor(model)

                            e.Box.Visible = state.Box
                            e.Box.Position = UDim2.fromOffset(cx - w / 2, cy - h / 2)
                            e.Box.Size = UDim2.fromOffset(w, h)

                            if state.Tracer then
                                local fy = pinned and (cy + h / 2) or botP.Y
                                local fx = pinned and cx or botP.X
                                local tgt = Vector2.new(fx, fy)
                                local dl = tgt - org
                                e.Tracer.Visible = true
                                e.Tracer.Size = UDim2.fromOffset(dl.Magnitude, 1.5)
                                e.Tracer.Position = UDim2.fromOffset((org.X + tgt.X) / 2, (org.Y + tgt.Y) / 2)
                                e.Tracer.Rotation = math.deg(math.atan2(dl.Y, dl.X))
                            else
                                e.Tracer.Visible = false
                            end

                            if state.Distance then
                                e.Label.Visible = true
                                e.Label.TextColor3 = col
                                e.Label.Text = string.format("%s%d studs",
                                    isBot(model) and "[BOT] " or "[P] ",
                                    math.floor(studs + 0.5))
                                e.Label.Position = UDim2.fromOffset(cx, cy - h / 2 - 2)
                            else
                                e.Label.Visible = false
                            end

                            if state.NameTag and e.NameLabel then
                                local plr = Players:GetPlayerFromCharacter(model)
                                e.NameLabel.Text = plr and plr.Name or model.Name
                                e.NameLabel.Visible = true
                                e.NameLabel.Position = UDim2.fromOffset(cx, cy + h / 2 + 2)
                            elseif e.NameLabel then
                                e.NameLabel.Visible = false
                            end

                            if state.HealthBar and e.HPBack and e.HPFill then
                                local r = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
                                e.HPBack.Visible = true
                                e.HPBack.Position = UDim2.fromOffset(cx - w / 2 - 8, cy - h / 2)
                                e.HPBack.Size = UDim2.fromOffset(4, h)
                                e.HPFill.Size = UDim2.fromScale(1, r)
                                e.HPFill.Position = UDim2.fromScale(0, 1 - r)
                                e.HPFill.BackgroundColor3 = Color3.fromRGB(
                                    math.floor(255 * (1 - r)), math.floor(255 * r), 0)
                            elseif e.HPBack then
                                e.HPBack.Visible = false
                            end
                        end
                    end)
                end
            end
        end
    end

    -- AIM LOCK (Delta: หมุน CFrame ตรงๆ ไม่ต้องง้อ MouseOffset)
    if state.LockAim and lockedTarget then
        local part = getAimPart(lockedTarget)
        if part then
            local sp = cam:WorldToViewportPoint(part.Position)
            if sp.Z > 0 then
                local tp = Vector2.new(sp.X, sp.Y)
                local c2 = vp / 2
                local alpha = math.clamp(state.AimSmooth * dt, 0, 1)
                local goalCF = CFrame.lookAt(cam.CFrame.Position, part.Position)
                cam.CFrame = cam.CFrame:Lerp(goalCF, alpha)

                if state.TriggerBot then
                    local d = (tp - c2).Magnitude
                    if d < 14 and (os.clock() - lastShot) >= state.TriggerDelay then
                        lastShot = os.clock()
                        deltaClick()
                    end
                end
            end
        end
    end
end)

--==================================================
-- LOAD FLUENT (Delta: หลายตัวบล็อก HttpGet — fallback หน้าต่างเอง)
--==================================================

local function loadFluent()
    local ok, result = pcall(function()
        local src = game:HttpGet(
            "https://github.com/dawid-scripts/Fluent/releases/latest/download/main.lua", true)
        assert(type(src) == "string" and #src > 0)
        local fn, err = loadstring(src)
        assert(fn, err)
        return fn()
    end)
    return ok and result or nil
end

